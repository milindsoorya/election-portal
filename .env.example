# ============================================================
# India Election Portal — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- Supabase ----
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose to the browser, server-side only
# Used by sync scripts and API routes to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- ECI Results ----
# Set this to the ECI results page URL once it goes live
# ECI publishes it a few days before results day
# Example patterns from past elections:
#   https://results.eci.gov.in/ResultAcGenApr2026/
#   https://results.eci.gov.in/AcResultGenMar2022/
ECI_RESULTS_URL=

# ---- MyNeta / ADR ----
# Election ID on myneta.info for Kerala 2026
# Find it by going to https://myneta.info/ and clicking on Kerala 2026
# The URL will contain the election_id, e.g. election_id=550
MYNETA_ELECTION_ID=

# State slug used in MyNeta URLs (e.g. 'kerala2026')
MYNETA_STATE_SLUG=kerala2026

# ---- Election Dates ----
ELECTION_DATE=2026-04-23
RESULT_DATE=2026-04-25

# ---- Sync ----
# Which state to sync (default: kerala)
SYNC_STATE=kerala

# Secret for protecting the /api/sync endpoint
# Set a long random string — include in Authorization: Bearer <secret> header
# Vercel Cron automatically passes this via cron.secret in project settings
CRON_SECRET=change-me-to-a-long-random-secret

# ---- Optional: Maps ----
# For the booth map view (Phase 5)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Optional: Analytics ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
